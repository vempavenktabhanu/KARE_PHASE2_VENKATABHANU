//reverse the String
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		String str = sc.nextLine();
		char ch[] = str.toCharArray();
		int s=0;
		int e=str.length()-1;
		while(s<e){
		    char temp = ch[s];
		    ch[s] = ch[e];
		    ch[e] = temp;
		    s++;
		    e--;
		}
		System.out.print(new String(ch));
		
		
	}
	    
}
