		Scanner sc=new Scanner(System.in);
		int n =sc.nextInt();
		int arr[] = new int[n];
		int i,ec=0,oc=0;
		for(i=0;i<n;i++){
		    arr[i]=sc.nextInt();
		    if(arr[i]%2==0)
		    ec++;
		    else
		    oc++;
		}
		System.out.println("odd elementCount: "+oc);
		System.out.println("even elementCount: "+ec);
		
		
	}
	    
}
