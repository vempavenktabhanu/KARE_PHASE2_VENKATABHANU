//Rotate Array by $K$ Positions: Clockwise (Right) and Anti-clockwise (Lef
import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        int k = sc.nextInt();

        // If k is greater than n
        k = k % n;

        // Right rotation
        for (int r = 1; r <= k; r++) {

            int last = a[n - 1];

            for (int i = n - 1; i > 0; i--) {
                a[i] = a[i - 1];
            }

            a[0] = last;
        }

        // Print array
        for (int i = 0; i < n; i++) {
            System.out.print(a[i] + " ");
        }
    }
}

//Find Leaders in Array: Elements greater than all elements on their right.  
```java
import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        // Last element is always a leader
        int max = a[n - 1];

        System.out.print(max + " ");

        // Check from right to left
        for (int i = n - 2; i >= 0; i--) {

            if (a[i] > max) {
                max = a[i];
                System.out.print(max + " ");
            }
        }
    }
}
//Maximum Subarray Sum (Kadane's Algorithm): Handle both positive and negative arrays
```java
import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        int currentSum = a[0];
        int maxSum = a[0];

        for (int i = 1; i < n; i++) {

            currentSum = Math.max(a[i], currentSum + a[i]);

            maxSum = Math.max(maxSum, currentSum);
        }

        System.out.println(maxSum);
    }
}


