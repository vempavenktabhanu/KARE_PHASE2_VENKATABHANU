//perfect NUMBER
// steps:
// get the input from user n = 6
// find the factor of n value including 1 excluding the given number
// find the sum of the factors sum=1+2+3=6
// compare sum and given number if both are equal print perfect number
import java.util.*;
class Main{
    public static void main(String args[]){
    Scanner bb = new Scanner(System.in);
    int n = bb.nextInt();
    int i,sum=0;
    for(i=1;i<=n/2;i++)
    {
        if(n%i==0)
        sum+=i;
    }
    if(sum==n)
    System.out.print("perfect NUMBER");
    else
    System.out.print("NOT A perfect NUMBER");
        
    }
    
}




