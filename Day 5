//write a java program on even digits in the given numbers
import java.util.*;
class Main{
    public static void main(String[] args){
    Scanner obj = new Scanner(System.in);
    int n = obj.nextInt();
    int d,ed=0,od=0;
    while(n!=0)
    {
        d=n%10;
        if(d%2==0)
        ed++;
        else
        od++;
        n=n/10;
        System.out.println("odd digit count: "+od);
        System.out.println("even digit count: "+ed);
        
        
    }
    }
}
